LLM_PROVIDER=openai_compatible
LLM_API_KEY=your_api_key_here
LLM_MODEL=qwen3.8-27b
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# RAG / Chroma
CHROMA_DB_DIR=db/chroma_db
CHROMA_COLLECTION_NAME=travel_guides
EMBEDDING_MODEL=qwen3.7-text-embedding
RERANK_MODEL=qwen3-rerank
EMBEDDING_BATCH_SIZE=10

# Redis / Cache
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=trip_planner
REDIS_DEFAULT_TTL_SECONDS=1800
REDIS_WEATHER_TTL_SECONDS=1800
REDIS_MAP_TTL_SECONDS=86400
REDIS_RAG_TTL_SECONDS=21600
REDIS_RERANK_TTL_SECONDS=21600

# Amap / Gaode Map
AMAP_API_KEY=your_amap_api_key
AMAP_BASE_URL=https://restapi.amap.com/v3
AMAP_DEFAULT_CITY=
AMAP_TIMEOUT_SECONDS=20
ENABLE_AMAP_ENRICHMENT=false
AMAP_MCP_ENABLED=false
AMAP_MCP_URL=http://127.0.0.1:8001/mcp
AMAP_MCP_TIMEOUT_SECONDS=10
AMAP_MCP_MAX_RETRIES=2
AMAP_MCP_RETRY_BACKOFF_SECONDS=0.25
AMAP_MCP_HOST=127.0.0.1
AMAP_MCP_PORT=8001
